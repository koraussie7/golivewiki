# sendgo-mcp 환경변수 예시. 실제 값은 채우지 말고 이 파일은 커밋하세요.
# 사용법: cp .env.example .env  →  .env 는 .gitignore 에 의해 커밋되지 않음

# --- 필수 ---
# Sendgo 콘솔에서 발급. 발신용 access key / secret key.
SENDGO_ACCESS_KEY=
SENDGO_SECRET_KEY=

# --- 선택 ---
# v1 | v2  (기본 v2)
# v1 은 발급받은 토큰을 한 번 더 Base64 인코딩해 Authorization 헤더에 넣는다.
SENDGO_API_VERSION=v2

# 기본 https://sendgo.io
SENDGO_BASE_URL=https://sendgo.io

# 기본 발신프로필(카카오 채널) 키. 미설정 시 요청마다 kakaoSenderKey 를 전달해야 한다.
# list_kakao_senders 도구로 조회 가능.
SENDGO_KAKAO_SENDER_KEY=
