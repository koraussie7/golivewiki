VITE_GOLIVE_API_BASE=https://golive.wiki/api

# SmartGlass live sharing: HTTPS base for task-scoped playback URLs.
# Leave empty to disable video sessions entirely (endpoint returns 503).
SMARTGLASS_STREAM_BASE=

# --- Task API auth & persistence (Phase 4) ---
# Supabase project JWT secret (HS256). Required for any authenticated route.
SUPABASE_JWT_SECRET=
# Alternative for projects on asymmetric signing keys: public JWKS endpoint.
SUPABASE_JWKS_URL=
# Postgres connection string. Empty => in-memory store (dev only, data lost on restart).
DATABASE_URL=

# --- Production CORS (Phase 5+) ---
# Comma-separated exact browser origins allowed to call the task API.
# In production, localhost is NOT added automatically.
CORS_ORIGINS=https://golive.wiki,https://smartglass.golive.wiki

# --- Requester web build (Vite, public values only) ---
# Base URL of the deployed task API.
VITE_GOLIVE_API_BASE=https://api.golive.wiki
# "true" => read the existing golive.wiki Supabase login session instead of a pasted token.
VITE_GOLIVE_USE_SUPABASE_SESSION=true
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
