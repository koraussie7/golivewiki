# Browser-visible Supabase project values (anon key only; never put service_role here)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional server API endpoint for future drone routes (current backend has no drone routes)
VITE_DRONE_API_BASE_URL=

# Optional authenticated MediaMTX WebRTC host; playback URL still must be short-lived and mission-authorized
VITE_MEDIAMTX_WEBRTC_BASE_URL=https://media.example.com
VITE_DRONE_MISSION_ID=
VITE_DRONE_STREAM=
